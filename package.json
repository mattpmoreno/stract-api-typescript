{
  "name": "stract-api",
  "version": "0.9.0",
  "description": "TypeScript SDK for the Stract API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattpmoreno/stract-api-typescript.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
