{
  "name": "stract-api",
  "version": "0.9.3",
  "description": "TypeScript SDK for the Stract API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattpmoreno/stract-api-typescript.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "pregenerate": "node -e \"for (const d of ['apis', 'models', 'docs']) require('fs').rmSync('src/' + d, { recursive: true, force: true })\"",
    "generate": "node scripts/generate.cjs",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').copyFileSync('LICENSE', 'dist/LICENSE')\"",
    "prepublishOnly": "npm run build",
    "test:sdk": "node --env-file=.env --test test/sdk.test.cjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.0",
    "typescript": "^5.6.0"
  }
}
